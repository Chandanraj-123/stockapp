# Docker ignore file
# Exclude files and directories that don't need to be in the Docker image

# Node.js
node_modules/
npm-debug.log

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.env
.venv
env/
venv/
ENV/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Test
.coverage
htmlcov/
.tox/
.nox/

# Git
.git/
.gitignore

# Docker
.dockerignore
Dockerfile
docker-compose*.yml

# Local configuration
.env
.env.*
!.env.example

# Frontend build (will be built in Docker)
.next/
out/

# Documentation (keep markdown files for reference)
# docs/
# *.md

# Keep shared-libs as it's needed for building
# shared-libs/
